# URL base de la instancia GitLab (SaaS o self-managed), sin barra final
GITLAB_URL=https://gitlab.com
# Personal/Project/Group access token con scope read_api. Sin valor por defecto.
GITLAB_TOKEN=
# Verificación TLS: true (defecto) o false solo con certificados autofirmados
GITLAB_VERIFY_SSL=true
# Tiempo de espera de las peticiones HTTP en segundos
GITLAB_TIMEOUT=30.0
# Límite por defecto de resultados en listados y búsquedas
GITLAB_DEFAULT_LIMIT=50
# Filtro opcional: ids, rutas de proyecto o rutas de grupo separados por coma.
# Vacío = sin restricción. Ej: GITLAB_PROJECT_FILTER=42,mi-org/subgrupo
#GITLAB_PROJECT_FILTER=
# Caché Redis opcional (vacío = sin caché)
#REDIS_URL=
#REDIS_TTL=300
