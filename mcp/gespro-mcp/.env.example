# URL base de la instancia Redmine/GESPRO (sin barra final opcional)
GESPRO_URL=https://redmine.example.com/
# Clave API del usuario Redmine (Administración > Clave API). Sin valor por defecto.
GESPRO_API_KEY=
# Verificación TLS: true (defecto) o false solo con certificados autofirmados
GESPRO_VERIFY_SSL=true
# Tiempo de espera de las peticiones HTTP en segundos
GESPRO_TIMEOUT=30.0
# Límite por defecto de resultados en búsquedas
GESPRO_DEFAULT_LIMIT=50
# Filtro opcional de proyectos: ids o identifiers separados por coma.
# Vacío = sin restricción. Ej: GESPRO_PROJECT_FILTER=16,58 o =noticias-proyectos-uci
#GESPRO_PROJECT_FILTER=
