# Copia este archivo a .env y rellena los valores reales.
# NUNCA subas .env a un repositorio.

# Proxy corporativo (CNTLM u otro) — exportar antes de ejecutar o en el crontab
# export HTTPS_PROXY=http://10.x.x.x:puerto
# export HTTP_PROXY=http://10.x.x.x:puerto

# ── GESPRO / Redmine ─────────────────────────────
# Redmine → Mi cuenta → clave API
REDMINE_API_KEY=

# ── GitLab ───────────────────────────────────────
# GitLab → Preferences → Access Tokens (scope: read_api)
GITLAB_TOKEN=

# ── Entrega por correo SMTP ──────────────────────
SMTP_USER=
SMTP_PASS=

# ── Entrega por Telegram ─────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
